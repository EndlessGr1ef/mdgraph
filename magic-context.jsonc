{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",

  "enabled": true,

  // 保留上下文压缩和历史召回能力
  "ctx_reduce_enabled": true,
  "temporal_awareness": true,

  // mdgraph 是项目事实源，所以先关闭 Magic Context 的自动长期记忆提升
  "memory": {
    "enabled": true,

    // 关键：关闭自动把 session facts 提升为 project memories
    // agent 仍然可以显式 ctx_memory write；已有 memories 仍可搜索和注入
    "auto_promote": false,

    // 保留自动搜索提示，让 agent 在需要时主动 ctx_search
    "auto_search": {
      "enabled": true
    },

    // 初期先不索引 git commit，避免变量太多；后续稳定后可打开
    "git_commit_indexing": {
      "enabled": false
    }
  },

  // 初期关闭 dreamer，避免它自动维护 ARCHITECTURE.md / STRUCTURE.md
  // 等确认不会影响 mdgraph 后，再考虑只开启 consolidate/verify/archive-stale/improve
  "dreamer": {
    "enabled": false,
    "tasks": ["consolidate", "verify", "archive-stale", "improve"],
    "inject_docs": false
  },

  // historian 负责后台压缩会话历史
  "historian": {
    "model": "openai/gpt-5.4-mini",

    // 初期限制后台 agent 权限，避免误写 mdgraph 管理的 Markdown 文件
    "tools": {
      "bash": false,
      "write": false,
      "edit": false
    },
    "permission": {
      "bash": "deny",
      "webfetch": "deny"
    }
  }
}
